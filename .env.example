# ---------------------------------------------------------------------------
# Every variable below is REQUIRED. The API and the portal refuse to boot when
# any one of them is missing. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Display name for the deployment. Never hardcode a brand string in source.
PRODUCT_NAME=Enterprise Data Exchange
TENANT_ID=TEN-DEMO

# Owns the schema: extensions, tables, policies. Migrations only.
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
# What the application connects as. A member of app_role, and crucially NOT a
# superuser: PostgreSQL exempts superusers from row-level security entirely,
# FORCE ROW LEVEL SECURITY included, so an application connecting as its own
# schema owner has tenant isolation switched off and nothing reports it.
# `npm run migrate` creates this role and re-asserts NOSUPERUSER NOBYPASSRLS.
APP_DATABASE_URL=postgresql://marketplace_app:marketplace_app@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379/0

OIDC_ISSUER=https://oidc.local/realms/marketplace
OIDC_CLIENT_ID=marketplace-portal
OIDC_CLIENT_SECRET=local-development-secret

SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
SNOWFLAKE_USER=SVC_MARKETPLACE_HARVEST
SNOWFLAKE_ROLE=MKT_READONLY
SNOWFLAKE_PRIVATE_KEY=

AGENT_RUNTIME=analytic
MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-5
MODEL_MAX_TOKENS=2000

DEMO_TIER_SCHEMA=MARKETPLACE_DEMO
# Scales the demo tier's row counts down from the manifests' rows_target. The
# distributions, seasonality, referential integrity and planted patterns are
# unaffected; only the row count changes. A full deployment uses 1.0.
DEMO_TIER_SCALE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
FEATURE_FLAG_SOURCE=env

# Worker poll cadence in seconds. Operational tuning, so it is configuration
# rather than a literal in source.
WORKER_POLL_SECONDS=5

# Portal -> API. The portal is an ordinary client of the API with no privileged path.
API_BASE_URL=http://localhost:8000/api/v1
PORTAL_BASE_URL=http://localhost:3000
# The portal's locale. Direction follows from it: a right-to-left language sets
# dir="rtl" on the document and every layout mirrors, because the styles are
# written in logical properties rather than left and right.
PORTAL_LOCALE=en

# Development identity. Until OIDC sign-in is wired (M12), server components call
# the API as this seeded party. Ignored when OIDC_ISSUER points at a real IdP.
PORTAL_DEV_SUBJECT=PTY-0061
