{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketplace:taxonomy",
  "title": "Taxonomy manifest",
  "description": "A controlled vocabulary seeded into a reference table.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "taxonomy",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "marketplace/v1"
    },
    "kind": {
      "const": "Taxonomy"
    },
    "taxonomy": {
      "type": "string",
      "enum": [
        "industry",
        "domain",
        "archetype",
        "purpose",
        "sensitivity",
        "source_system"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*|SRC-[A-Z0-9-]+)$",
            "description": "Lowercase snake case for vocabularies; SRC-<NAME> for source systems."
          },
          "label": {
            "$ref": "urn:marketplace:common#/$defs/nonEmptyText"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "rank_order": {
            "type": "integer",
            "minimum": 1
          },
          "requires_purpose": {
            "type": "boolean"
          },
          "requires_free_text": {
            "type": "boolean"
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "owner_team": {
            "$ref": "urn:marketplace:common#/$defs/nonEmptyText"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "tier1",
              "tier2",
              "tier3"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "pattern": "^SRC-"
                }
              }
            },
            "then": {
              "required": [
                "platform",
                "owner_team",
                "criticality"
              ]
            }
          }
        ]
      }
    }
  }
}
