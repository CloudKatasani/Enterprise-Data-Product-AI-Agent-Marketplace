{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketplace:policy",
  "title": "Policy manifest",
  "description": "Versioned workflow policy. Changing a path or an SLA here must never require a code change.",
  "type": "object",
  "required": [
    "policy",
    "version",
    "paths",
    "escalation",
    "grant",
    "purposes_by_sensitivity",
    "pre_approved_roles",
    "sla_unit"
  ],
  "additionalProperties": false,
  "properties": {
    "policy": {
      "type": "string",
      "enum": [
        "access_request"
      ]
    },
    "version": {
      "$ref": "urn:marketplace:common#/$defs/semver"
    },
    "sla_unit": {
      "type": "string",
      "enum": [
        "business_days",
        "calendar_days"
      ]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "when",
          "sla_days",
          "approvers"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "auto",
              "certified_auto",
              "owner",
              "owner_steward",
              "owner_privacy_security",
              "blocked"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "object"
          },
          "sla_days": {
            "type": "integer",
            "minimum": 0
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "owner",
                "steward",
                "privacy",
                "security",
                "architect"
              ]
            }
          },
          "offer_alternative": {
            "type": "boolean"
          }
        }
      }
    },
    "pre_approved_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "at_fraction_of_sla",
        "to_role",
        "on_breach_to_role"
      ],
      "additionalProperties": false,
      "properties": {
        "at_fraction_of_sla": {
          "$ref": "urn:marketplace:common#/$defs/unitInterval"
        },
        "to_role": {
          "type": "string"
        },
        "on_breach_to_role": {
          "type": "string"
        }
      }
    },
    "grant": {
      "type": "object",
      "required": [
        "duration_days",
        "renewal_notice_days",
        "dormant_after_days"
      ],
      "additionalProperties": false,
      "properties": {
        "duration_days": {
          "type": "integer",
          "minimum": 1
        },
        "renewal_notice_days": {
          "type": "integer",
          "minimum": 1
        },
        "dormant_after_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "purposes_by_sensitivity": {
      "type": "object",
      "required": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  }
}
